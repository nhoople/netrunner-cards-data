  },
  "subroutines": [
    {
      "id": "lamplighter-tag",
      "text": "Give the Runner 1 tag unless they pay 3[credit].",
      "effect": {
        "op": "do",
        "action": {
          "kind": "unless",
          "payer": "runner",
          "cost": {
            "op": "do",
            "action": {
              "kind": "lose_credits",
              "side": "runner",
              "amount": 3
            }
          },
          "instruction": {
            "op": "do",
            "action": {
              "kind": "give_tags",
              "amount": 1
            }
          }
        }
      }
    },
    {
      "id": "lamplighter-etr",
      "text": "End the run if the Runner is tagged.",
      "effect": {
        "op": "if",
        "cond": {
          "op": "runner_tagged"
        },
        "then": {
          "op": "do",
          "action": {
            "kind": "end_the_run"
          }
        }
      }
    }
  ]
