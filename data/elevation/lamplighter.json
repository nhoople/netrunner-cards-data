  "type": "ice",
  "side": "corp",
  "unsupported": [],
  "subtypes": [
    "sentry",
    "observer"
  ],
  "installCost": 2,
  "rezCost": 2,
  "strength": 3,
  "onAgendaScoredOrStolen": {
    "op": "if",
